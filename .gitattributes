# Auto detect text files and perform LF normalization
* text=auto

# Language stats on GitHub should describe the code that was actually written
# here, not the libraries this template shipped with. Without this the repo of
# a C++ developer gets labelled by whatever vendored stylesheet is largest.
css/bootstrap.css      linguist-vendored
css/owl.*              linguist-vendored
js/jquery*.js          linguist-vendored
js/bootstrap.min.js    linguist-vendored
fonts/**               linguist-vendored
